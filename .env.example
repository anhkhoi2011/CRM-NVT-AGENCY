# Sao chép thành .env trong Application Root trên hosting; không commit file .env thật.
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpanel_database_user
DB_PASSWORD=replace_with_database_password
DB_NAME=cpanel_database_name
DB_CONNECTION_LIMIT=5

# CPanel/Passenger thường tự cấp PORT; không đặt PORT trên hosting nếu cPanel đã quản lý.
HOST=0.0.0.0
# PORT=4173

# Bật token cho webhook Landing Page nếu bên gửi hỗ trợ header x-api-key.
WEBHOOK_TOKEN=replace_with_random_webhook_token
WEBHOOK_DATA_DIR=/home/gdyeksti/webhook-data

# Telegram bot credentials are configured on the host and never committed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=HotroTinNhanCRM_bot
# Chat ID cua tai khoan Admin nhan thong bao ho tro noi bo qua Telegram.
TELEGRAM_ADMIN_CHAT_ID=
# Bat dong bo phan hoi Telegram -> CRM: URL HTTPS public va chuoi bi mat ngau nhien.
TELEGRAM_WEBHOOK_URL=https://crm.example.com/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Thu muc luu anh chat ho tro, nam ngoai public web va chi tra qua API da xac thuc.
# SUPPORT_UPLOAD_DIR=/home/cpanel_user/crm-support-uploads

# Tùy chọn gửi email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CRM_EMAIL_TOKEN=
