# Sao chép thành .env trong Application Root trên hosting; không commit file .env thật.
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpanel_database_user
DB_PASSWORD=replace_with_database_password
DB_NAME=cpanel_database_name
DB_CONNECTION_LIMIT=5

# CPanel/Passenger thường tự cấp PORT; không đặt PORT trên hosting nếu cPanel đã quản lý.
HOST=0.0.0.0
# PORT=4173

# Bật token cho webhook Landing Page nếu bên gửi hỗ trợ header x-api-key.
WEBHOOK_TOKEN=replace_with_random_webhook_token
WEBHOOK_DATA_DIR=/home/gdyeksti/webhook-data

# Tùy chọn gửi email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CRM_EMAIL_TOKEN=
