# Giữ Node.js Passenger hoạt động liên tục để giảm cold start khi mở hoặc F5.
<IfModule mod_passenger.c>
  PassengerMinInstances 1
  PassengerPoolIdleTime 0
</IfModule>

# NVT AGENCY CRM - UTF-8 for Apache/LiteSpeed
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .htm .css .js .cjs .json .svg .txt
<IfModule mod_mime.c>
  AddType "text/html; charset=UTF-8" .html .htm
  AddType "text/css; charset=UTF-8" .css
  AddType "application/javascript; charset=UTF-8" .js .cjs
  AddType "application/json; charset=UTF-8" .json
  AddType "image/svg+xml; charset=UTF-8" .svg
</IfModule>

# Compress static responses without caching HTML or API responses.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|cjs|svg|png|jpe?g|webp|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "^(?:index|crm-runtime)\.html$">
    Header set Cache-Control "no-store, max-age=0"
  </FilesMatch>
</IfModule>
